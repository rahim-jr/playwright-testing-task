# Bangladesh Railway E-Ticket Credentials
RAILWAY_MOBILE_NUMBER=01XXXXXXXXX
RAILWAY_PASSWORD=your_password_here

# Base URL (default: https://eticket.railway.gov.bd)
BASE_URL=https://eticket.railway.gov.bd

# Browser execution mode: true for headless, false for headed (browser window visible)
HEADLESS=false

# Test Booking Parameters (optional defaults)
FROM_STATION=DHAKA
TO_STATION=CHATTOGRAM
JOURNEY_DATE=
# JOURNEY_CLASS supports comma-separated priority: SNIGDHA,F_SEAT,S_CHAIR
JOURNEY_CLASS=SNIGDHA,F_SEAT,S_CHAIR
TRAIN_NUMBER=
REFRESH_MIN_SECONDS=2
REFRESH_MAX_SECONDS=4
